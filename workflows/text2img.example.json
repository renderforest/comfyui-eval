{
  "_comment": "EXAMPLE ONLY (basic SD checkpoint graph). Export YOUR workflow from ComfyUI in API format (Settings -> enable Dev mode -> 'Save (API Format)'), insert the %%...%% placeholders, and save it as workflows/text2img.json. Supported placeholders: %%PROMPT%%, %%STYLE%%, %%SEED%%. A string that is exactly %%SEED%% is replaced with a number.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "your-model.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "%%PROMPT%%, %%STYLE%%" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "" }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": "%%SEED%%",
      "steps": 25,
      "cfg": 7,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "images": ["6", 0], "filename_prefix": "eval" }
  }
}
